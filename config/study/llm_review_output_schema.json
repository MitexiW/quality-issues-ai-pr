{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blind PR quality and security review output",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_family",
          "file_path",
          "line_start",
          "line_end",
          "hunk_header",
          "weakness_category",
          "severity",
          "explanation",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "issue_family": {"enum": ["quality", "security"]},
          "file_path": {"type": "string", "minLength": 1},
          "line_start": {"type": ["integer", "null"], "minimum": 1},
          "line_end": {"type": ["integer", "null"], "minimum": 1},
          "hunk_header": {"type": "string"},
          "weakness_category": {"type": "string", "minLength": 1},
          "severity": {
            "enum": ["critical", "high", "medium", "low", "informational"]
          },
          "explanation": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
