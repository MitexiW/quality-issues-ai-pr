{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeQL introduced alert adjudication batch",
  "type": "object",
  "required": ["adjudications"],
  "properties": {
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "alert_id",
          "condition_present",
          "valid_issue",
          "introduced_by_pr",
          "actionability",
          "confidence",
          "evidence",
          "rationale"
        ],
        "properties": {
          "alert_id": {"type": "string", "minLength": 1},
          "condition_present": {
            "enum": ["yes", "no", "uncertain"]
          },
          "valid_issue": {
            "enum": ["yes", "no", "contextual_exception", "uncertain"]
          },
          "introduced_by_pr": {
            "enum": ["yes", "no", "uncertain"]
          },
          "actionability": {
            "enum": ["must_fix", "should_fix", "optional", "no_fix", "uncertain"]
          },
          "confidence": {
            "enum": ["high", "medium", "low"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["revision", "file", "line", "explanation"],
              "properties": {
                "revision": {"enum": ["before", "head"]},
                "file": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "explanation": {"type": "string", "minLength": 1, "maxLength": 1000}
              },
              "additionalProperties": false
            }
          },
          "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
